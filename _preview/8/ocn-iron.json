=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"pCCCC4MK75"},{"type":"output","id":"A-eqHl4k5B6Xb3WBTrXZp","data":[],"key":"hAN6avT3lB"}],"key":"OtPidxwNeL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UMVo7hF4Xt"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"eikRm30OhY"}],"key":"dzmjIgUx7R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"DvyFewhdKF"},{"type":"output","id":"3D34sTZlxf8YiRhbH53MJ","data":[],"key":"QO6LjH5B2o"}],"key":"lYJlujNc8f"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"hrCFRbg9Fa"},{"type":"output","id":"zYkc2zWdg6l3XeMBI_z8s","data":[],"key":"mJOZNu75YC"}],"key":"VYHMhpKwNS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"dFLc4zQ3lK"},{"type":"output","id":"87JeSIjUKdL4WGGFlXtyi","data":[],"key":"P9p37bdvq9"}],"key":"Jtulp25Lkh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SkdAcdoEBF"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"uvVHxm1nWJ"}],"key":"nPXqE0QkFX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Uepx5df4V4"}],"key":"voe1GRI2uP"}],"key":"ES5XDm4WX8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"O5GYRRkPSu"},{"type":"output","id":"Ljwt-vCPHBASRr5FSnOV6","data":[],"key":"QvPzXgq0F2"}],"key":"J2hp0YPEWN"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oRgPxAmJAp"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"c